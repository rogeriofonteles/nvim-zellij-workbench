layout {
    tab name=__WORKBENCH_TAB_NAME__ focus=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane focus=true command=__NVIM_WORKBENCH_COMMAND__ {
            args "."
            name "Neovim"
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
