#!/usr/bin/env bash
set -euo pipefail

# Keep the original entry point, but use the terminal-native combined surface.
# This works in local terminals, VMs, and SSH sessions without launching a GUI
# terminal window. Inside Zellij, surface-workbench creates or selects a tab.
workbench_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$workbench_root/bin/surface-workbench" "$@"
