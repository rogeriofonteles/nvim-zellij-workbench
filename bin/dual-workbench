#!/usr/bin/env bash
set -euo pipefail

workbench_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project="${1:-$PWD}"
project="$(cd "$project" && pwd)"
project_name="$(basename "$project")"
tab_name="$(printf '%s' "$project_name" | tr -cs '[:alnum:]_.-' '-')"

editor_session="workbench-v2-editor"
agent_session="workbench-v2-agent"
editor_layout="$workbench_root/layouts/workbench.kdl"
agent_layout="$workbench_root/layouts/agent.kdl"

for command_name in gnome-terminal zellij wmctrl; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "dual-workbench requires $command_name." >&2
    exit 1
  fi
done

session_exists() {
  local session="$1"
  zellij list-sessions --short 2>/dev/null | grep -Fxq "$session"
}

tab_exists() {
  local session="$1"
  local name="$2"
  zellij --session "$session" action query-tab-names 2>/dev/null | grep -Fxq "$name"
}

window_id() {
  local session="$1"
  wmctrl -lx 2>/dev/null | awk -v marker="$session |" 'index($0, marker) { print $1; exit }'
}

wait_for_session() {
  local session="$1"
  local attempt
  for attempt in {1..50}; do
    session_exists "$session" && return 0
    sleep 0.1
  done
  echo "Timed out waiting for Zellij session $session." >&2
  return 1
}

wait_for_first_tab() {
  local session="$1"
  local attempt
  for attempt in {1..50}; do
    if zellij --session "$session" action query-tab-names 2>/dev/null | grep -q .; then
      return 0
    fi
    sleep 0.1
  done
  echo "Timed out waiting for the first tab in $session." >&2
  return 1
}

launch_session_window() {
  local session="$1"
  local layout="$2"
  local title="$3"
  local command

  printf -v command \
    'cd %q && exec zellij attach --create %q options --default-layout %q --default-cwd %q' \
    "$project" "$session" "$layout" "$project"
  gnome-terminal --window --title="$title" -- bash -lc "$command"
}

attach_session_window() {
  local session="$1"
  local title="$2"
  local command

  printf -v command 'exec zellij attach %q' "$session"
  gnome-terminal --window --title="$title" -- bash -lc "$command"
}

ensure_project_tab() {
  local session="$1"
  local layout="$2"
  local title="$3"
  local new_tab_id
  local launched_window=false

  if ! session_exists "$session"; then
    launch_session_window "$session" "$layout" "$title"
    launched_window=true
    wait_for_session "$session"
    wait_for_first_tab "$session"
    # The initial layout has a generic tab name; make it this project's tab.
    zellij --session "$session" action rename-tab --tab-id 0 "$tab_name" >/dev/null
  elif ! tab_exists "$session" "$tab_name"; then
    # A name inside the layout overrides new-tab --name. Rename the exact tab
    # returned by Zellij so editor and agent tabs always share the project name.
    new_tab_id="$(zellij --session "$session" action new-tab \
      --cwd "$project" --layout "$layout")"
    zellij --session "$session" action rename-tab \
      --tab-id "$new_tab_id" "$tab_name" >/dev/null
  fi

  if [[ "$launched_window" == false && -z "$(window_id "$session")" ]]; then
    attach_session_window "$session" "$title"
  fi
}

reveal_windows() {
  local editor_id agent_id desktop attempt
  for attempt in {1..50}; do
    editor_id="$(window_id "$editor_session")"
    agent_id="$(window_id "$agent_session")"
    [[ -n "$editor_id" && -n "$agent_id" ]] && break
    sleep 0.1
  done

  [[ -n "${editor_id:-}" && -n "${agent_id:-}" ]] || return 0
  desktop="$(wmctrl -l | awk -v id="$editor_id" '$1 == id { print $2; exit }')"
  if [[ "$desktop" =~ ^[0-9]+$ ]]; then
    wmctrl -i -r "$agent_id" -t "$desktop"
    wmctrl -s "$desktop"
  fi
  wmctrl -i -r "$editor_id" -b remove,hidden
  wmctrl -i -r "$agent_id" -b remove,hidden
  wmctrl -i -a "$editor_id"
}

ensure_project_tab "$editor_session" "$editor_layout" "Workbench — Editor"
ensure_project_tab "$agent_session" "$agent_layout" "Workbench — Agent"

zellij --session "$editor_session" action go-to-tab-name "$tab_name" >/dev/null
zellij --session "$agent_session" action go-to-tab-name "$tab_name" >/dev/null
reveal_windows
